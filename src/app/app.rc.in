// Generated into the build directory by CMake (absolute paths to the embedded DLLs).
#include <winres.h>
#include "@WCS_APP_DIR@/resource.h"

IDR_VCAM_X64 RCDATA "@WCS_EMBED_DIR@/WebcamShareCam_x64.dll"
IDR_VCAM_X86 RCDATA "@WCS_EMBED_DIR@/WebcamShareCam_x86.dll"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @WCS_VERSION_COMMAS@
 PRODUCTVERSION @WCS_VERSION_COMMAS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "WebcamShare - virtual camera 720p"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "WebcamShare"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "WebcamShare.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
